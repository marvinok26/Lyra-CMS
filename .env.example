# Copy to .env and adjust as needed. All values here have working defaults in
# docker-compose.yml — you only need this file to override them.

# Default tenant's admin account, created on first boot via Orchard Core AutoSetup.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@lyra.local
ADMIN_PASSWORD=ChangeMe!2026Secure

# Lyra.AiPageBuilder provider. "Mock" (the default) needs no configuration and works offline —
# see docs/ai-page-generator.md for OpenAI/Anthropic setup.
AI_PROVIDER=Mock
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
