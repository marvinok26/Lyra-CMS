@model Lyra.AiPageBuilder.ViewModels.GeneratePageViewModel

<h1>AI Page Builder</h1>

<p class="text-muted">
    Describe the page you want in plain language. The result is created as a draft you can review
    before it goes live — nothing is published automatically.
</p>

<form asp-action="Index" method="post" class="mb-4">
    <div class="mb-3">
        <label asp-for="Prompt" class="form-label">What page do you want?</label>
        <textarea asp-for="Prompt" class="form-control" rows="3"
                  placeholder="e.g. a landing page for a coffee shop with fast wifi, fresh pastries, and weekend live music"></textarea>
        <span asp-validation-for="Prompt" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Generate</button>
</form>
